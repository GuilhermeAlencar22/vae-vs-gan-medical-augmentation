    {
      "name": "Análise estatística",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/analisar.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
